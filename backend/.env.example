# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Qdrant Cloud ---
QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=case_fingerprints

# --- Embedding model ---
# all-MiniLM-L6-v2 = 384-dim. If you change the model, update EMBEDDING_DIM to match,
# then re-run scripts/init_qdrant_collection.py against a fresh collection.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Groq (research chat agent) ---
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
